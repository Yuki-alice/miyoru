CREATE TABLE PLUGIN_REPOSITORY (
  id TEXT NOT NULL PRIMARY KEY,
  url TEXT NOT NULL UNIQUE,
  name TEXT NOT NULL,
  description TEXT,
  website_url TEXT,
  icon_url TEXT,
  schema_version INTEGER NOT NULL,
  signing_key TEXT,
  fingerprint TEXT NOT NULL,
  enabled INTEGER NOT NULL DEFAULT 1,
  last_updated INTEGER NOT NULL,
  last_error TEXT,
  plugin_count INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL
);

CREATE TABLE REPOSITORY_PLUGIN (
  repository_id TEXT NOT NULL,
  plugin_id TEXT NOT NULL,
  name TEXT NOT NULL,
  version TEXT NOT NULL,
  api_version INTEGER NOT NULL,
  min_app_version TEXT NOT NULL,
  media_types_json TEXT NOT NULL,
  capabilities_json TEXT NOT NULL,
  domains_json TEXT NOT NULL,
  author TEXT,
  homepage TEXT,
  icon_url TEXT,
  description TEXT,
  download_url TEXT NOT NULL,
  package_sha256 TEXT NOT NULL,
  PRIMARY KEY (repository_id, plugin_id)
);

CREATE INDEX repository_plugin_repo_idx ON REPOSITORY_PLUGIN(repository_id);

selectAllRepositories:
SELECT * FROM PLUGIN_REPOSITORY ORDER BY created_at;

selectRepositoryById:
SELECT * FROM PLUGIN_REPOSITORY WHERE id = ?;

selectRepositoryByUrl:
SELECT * FROM PLUGIN_REPOSITORY WHERE url = ?;

insertRepository:
INSERT OR REPLACE INTO PLUGIN_REPOSITORY (
  id, url, name, description, website_url, icon_url, schema_version,
  signing_key, fingerprint, enabled, last_updated, last_error, plugin_count, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRepositoryMeta:
UPDATE PLUGIN_REPOSITORY
SET name = ?, description = ?, website_url = ?, icon_url = ?, schema_version = ?,
    fingerprint = ?, last_updated = ?, last_error = NULL, plugin_count = ?
WHERE id = ?;

updateRepositoryEnabled:
UPDATE PLUGIN_REPOSITORY SET enabled = ?, last_updated = ? WHERE id = ?;

updateRepositoryError:
UPDATE PLUGIN_REPOSITORY SET last_error = ? WHERE id = ?;

deleteRepositoryById:
DELETE FROM PLUGIN_REPOSITORY WHERE id = ?;

selectAllCachedPlugins:
SELECT * FROM REPOSITORY_PLUGIN ORDER BY repository_id, plugin_id;

selectCachedPluginsByRepository:
SELECT * FROM REPOSITORY_PLUGIN WHERE repository_id = ? ORDER BY plugin_id;

selectCachedPlugin:
SELECT * FROM REPOSITORY_PLUGIN WHERE repository_id = ? AND plugin_id = ?;

insertOrReplaceCachedPlugin:
INSERT OR REPLACE INTO REPOSITORY_PLUGIN (
  repository_id, plugin_id, name, version, api_version, min_app_version,
  media_types_json, capabilities_json, domains_json, author, homepage,
  icon_url, description, download_url, package_sha256
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCachedPluginsByRepository:
DELETE FROM REPOSITORY_PLUGIN WHERE repository_id = ?;
